{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Headroom",
  "version": "0.1.0",
  "identifier": "dev.headroom.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "npm run dev -- --port 5174 --strictPort",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Headroom",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "rpm"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "category": "Utility",
    "shortDescription": "Limpa artefatos regeneráveis de projetos mostrando o espaço real liberado",
    "longDescription": "Encontra node_modules, target, .venv e caches dos seus projetos, valida cada um por uma regra, mostra o espaço que de fato volta (contando hardlinks) e apaga só o que você confirmar. Fica na bandeja e avisa quando o disco enche ou quando vale limpar.",
    "publisher": "Gabriel Martins",
    "homepage": "https://github.com/martinsgabriel1956/headroom",
    "license": "MIT",
    "copyright": "Copyright (c) 2026 Gabriel Martins",
    "linux": {
      "deb": {
        "recommends": [
          "libnotify-bin"
        ]
      },
      "rpm": {
        "recommends": [
          "libnotify"
        ]
      }
    }
  }
}
